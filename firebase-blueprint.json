{
  "entities": {
    "insight": {
      "title": "Insight Post",
      "description": "A blog post or insight article.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "The title of the post." },
        "summary": { "type": "string", "description": "A short summary for the feed." },
        "content": { "type": "string", "description": "The full body content (markdown)." },
        "author": { "type": "string", "description": "The author name." },
        "date": { "type": "string", "format": "date-time", "description": "Publication date." },
        "image": { "type": "string", "description": "URL to the featured image." },
        "tag": { "type": "string", "description": "Primary tag/category label." },
        "status": { "type": "string", "enum": ["draft", "published"], "description": "Status of the post." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "summary", "content", "status"]
    },
    "siteSetting": {
      "title": "Site Setting",
      "description": "General site content or configuration.",
      "type": "object",
      "properties": {
        "key": { "type": "string", "description": "Unique key for the setting." },
        "value": { "type": "object", "description": "The setting data." },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["key", "value"]
    },
    "admin": {
      "title": "Admin User",
      "description": "Users with admin access.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin"] }
      },
      "required": ["email", "role"]
    },
    "enquiry": {
      "title": "Contact Enquiry",
      "description": "Form submissions from the contact page.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "company": { "type": "string" },
        "country": { "type": "string" },
        "service": { "type": "string" },
        "message": { "type": "string" },
        "submittedAt": { "type": "string", "format": "date-time" },
        "source": { "type": "string" }
      },
      "required": ["name", "email", "message", "submittedAt"]
    },
    "teamMember": {
      "title": "Team Member",
      "description": "A staff member featured in the team section.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Full name of the member." },
        "role": { "type": "string", "description": "Job title or role description." },
        "photo": { "type": "string", "description": "URL to the profile photo." },
        "order": { "type": "number", "description": "Display order." },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "role", "photo", "order"]
    },
    "testimonial": {
      "title": "Testimonial",
      "description": "Client review or testimonial.",
      "type": "object",
      "properties": {
        "quote": { "type": "string", "description": "The testimonial quote text." },
        "author": { "type": "string", "description": "The person giving the testimonial." },
        "role": { "type": "string", "description": "Job title/role of the author." },
        "company": { "type": "string", "description": "Company name of the author." },
        "order": { "type": "number", "description": "Display order." },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["quote", "author", "role", "company", "order"]
    }
  },
  "firestore": {
    "insights": {
      "schema": "insight",
      "description": "Collection of insight posts."
    },
    "siteSettings": {
      "schema": "siteSetting",
      "description": "Key-value pair settings for site content."
    },
    "admins": {
      "schema": "admin",
      "description": "Admin users list."
    },
    "enquiries": {
      "schema": "enquiry",
      "description": "Contact form submissions."
    },
    "team": {
      "schema": "teamMember",
      "description": "Staff members list."
    },
    "testimonials": {
      "schema": "testimonial",
      "description": "Client reviews list."
    }
  }
}
